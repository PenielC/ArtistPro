# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://artistpro:artistpro@localhost:5437/artistpro?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6381"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRY_SECONDS="900"
JWT_REFRESH_EXPIRY_DAYS="7"

# API
PORT=4000
WEB_BASE_URL="http://localhost:5173"

# Stripe (test keys) — not used yet; Paynow is the first provider
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Online payments (Payments module)
# Encrypts each organisation's merchant keys at rest. Generate once and keep it stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored merchant keys unreadable (organisations would have to re-enter them).
PAYMENTS_ENCRYPTION_KEY=""
# Public base URL of this API — Paynow posts payment results here. Must be public HTTPS in production.
API_PUBLIC_URL="http://localhost:4000"
# Paynow API base; only override to point at a test double.
PAYNOW_API_BASE="https://www.paynow.co.zw"
# Built-in simulated checkout for local development. NEVER "true" in production.
PAYMENTS_TEST_PROVIDER="false"

# Object storage (S3-compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (Notifications module) — any SMTP service (Resend, Postmark, SES, Zoho, Gmail… all offer SMTP).
# Locally: `docker compose up -d mailpit`, keep these defaults, and read mail at http://localhost:8027
SMTP_HOST="localhost"
SMTP_PORT="1027"
# true for implicit TLS (usually port 465); false uses STARTTLS when the server offers it (587)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Sender address; must be on a domain your SMTP provider has verified. Shown as "<Org name> via ArtBH".
EMAIL_FROM_ADDRESS="notifications@artbh.local"
# Overdue-invoice reminder run: cron pattern + IANA timezone (BullMQ job scheduler)
REMINDERS_CRON="0 8 * * *"
REMINDERS_TZ="Africa/Harare"
# Unused (superseded by SMTP above)
EMAIL_PROVIDER_API_KEY=""

# AI (AI Artist Manager) — Claude via the Anthropic SDK. Setting ANTHROPIC_API_KEY switches AI on;
# without it the AI endpoints answer 503 (or canned demo answers when AI_DEMO_MODE="true").
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
# Canned demo answers without a key, for local development only (ignored when NODE_ENV=production)
AI_DEMO_MODE="false"
# Unused (superseded by ANTHROPIC_API_KEY)
AI_PROVIDER_API_KEY=""

# Sentry
SENTRY_DSN=""

# Platform admins (comma-separated emails). They see the Admin area: analytics across all businesses,
# suspending businesses, AI limits and platform settings. Nothing in the app can grant this.
PLATFORM_ADMIN_EMAILS=
